# =============================================================================
# Trophibot Monitor — Environment Variables
# =============================================================================
# Copy this file to `.env` (in the monitor/ folder) and fill in the real values.
# NEVER commit `.env` to git.

# Required. Discord bot token used by the monitor to connect to the gateway.
# Tip: if you want to keep the main bot's permissions clean, create a SEPARATE
# bot in the Discord Developer Portal just for monitoring — it only needs to
# observe forum threads and gateway events.
DISCORD_TOKEN=your_monitor_bot_token_here

# Optional. HTTP/WebSocket port for the dashboard. Default: 3000.
PORT=3000

# Optional. Interface to bind. Default: 127.0.0.1 (localhost only — safest).
# Set to 0.0.0.0 to expose the dashboard on your LAN (no auth — be careful).
HOST=127.0.0.1
